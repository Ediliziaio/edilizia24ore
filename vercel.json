{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/guide-pratiche/facciata-ventilata-preventivo-prezzo-completo",
      "destination": "/articolo/facciata-ventilata-preventivo-prezzo-completo",
      "permanent": true
    },
    {
      "source": "/speciali-aziende/renova-solution-una-scheda-di-progetto-per-la-ristrutturazione",
      "destination": "/articolo/renova-solution-una-scheda-di-progetto-per-la-ristrutturazione",
      "permanent": true
    },
    {
      "source": "/speciali-aziende/innovasol-dal-primo-contatto-a-una-richiesta-di-impianto-piu-chiara",
      "destination": "/articolo/innovasol-dal-primo-contatto-a-una-richiesta-di-impianto-piu-chiara",
      "permanent": true
    },
    {
      "source": "/speciali-aziende/green-energy-group-e-le-cer-le-domande-per-iniziare-il-confronto",
      "destination": "/articolo/green-energy-group-e-le-cer-le-domande-per-iniziare-il-confronto",
      "permanent": true
    },
    {
      "source": "/guide-pratiche",
      "destination": "/categoria/news",
      "permanent": true
    },
    {
      "source": "/speciali-aziende",
      "destination": "/categoria/news",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "edilizia24ore.it"
        }
      ],
      "destination": "https://www.edilizia24ore.it/$1",
      "permanent": true
    },
    {
      "source": "/autore/:slug*",
      "destination": "https://www.edilizia24ore.it/chi-siamo",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}

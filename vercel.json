{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "edilizia24ore.it"
        }
      ],
      "destination": "https://www.edilizia24ore.it/$1",
      "permanent": true
    },
    {
      "source": "/autore/marco-ferrante",
      "destination": "https://www.edilizia24ore.it/autore/tommaso-salvetti",
      "permanent": true
    },
    {
      "source": "/autore/elena-riva",
      "destination": "https://www.edilizia24ore.it/autore/federica-anselmi",
      "permanent": true
    },
    {
      "source": "/autore/giulia-bianchi",
      "destination": "https://www.edilizia24ore.it/autore/beatrice-ongaro",
      "permanent": true
    },
    {
      "source": "/autore/paolo-moretti",
      "destination": "https://www.edilizia24ore.it/autore/nicola-trevisan",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
